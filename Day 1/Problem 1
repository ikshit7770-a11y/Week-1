package Arrayss;
import java.util.Arrays;
public class TwoSum {
    public static void main(String[] args) {
        int[] nums = {1, 2, 43, 435, 6};
        int n = nums.length;
        int target = 44;
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                if (nums[i] + nums[j] == target) {
                    System.out.println(nums[i] + " " + nums[j]);
                }
            }
        }
        System.out.println("not present");
    }
}
